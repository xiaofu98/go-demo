# 编译生成的二进制文件
*.exe
*.exe~
*.dll
*.so
*.dylib

# Go编译过程中生成的中间文件
*.o
*.a
*.test

# Go模块下载的依赖
/vendor/
/go.sum

# Go项目的构建输出目录
/bin/
/build/
/dist/

# 集成开发环境(IDE)的配置文件
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# 测试相关的临时文件
coverage.out
profile.cov
*.test

# 操作系统相关的临时文件
.DS_Store
Thumbs.db

# 环境变量配置文件，通常包含敏感信息
.env
.env.local

# 日志文件
logs/
*.log

# 其他可能的临时文件和目录
tmp/
temp/
    
